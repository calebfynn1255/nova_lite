<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaLite.UI.Controls.TypingIndicator">

    <Border Background="{DynamicResource AiBubbleBrush}"
            CornerRadius="18,18,18,4"
            Padding="14,10"
            HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Nova is thinking" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Ellipse x:Name="Dot1" Width="6" Height="6" Opacity="0.3"
                         Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5"/>
                <Ellipse x:Name="Dot2" Width="6" Height="6" Opacity="0.3"
                         Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5"/>
                <Ellipse x:Name="Dot3" Width="6" Height="6" Opacity="0.3"
                         Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
