<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaLite.UI.ViewModels"
        xmlns:views="using:NovaLite.UI.Views"
        xmlns:controls="using:NovaLite.UI.Controls"
        x:Class="NovaLite.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NovaLite"
        Width="1240"
        Height="800"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Icon="avares://NovaLite/Assets/icon.png">

    <!-- Design-time DataContext removed to avoid runtime type resolution issues when trimmed -->

    <!-- DataTemplates: map each ViewModel type to its View -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:WelcomePageViewModel}">
            <views:WelcomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatPageViewModel}">
            <views:ChatPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelManagerViewModel}">
            <views:ModelManagerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutPage/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="240,*">

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSidebarBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource BorderBrush}">

            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34"
                                CornerRadius="9"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="N"
                                       FontSize="19"
                                       FontWeight="ExtraBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NovaLite"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Local AI"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Active model name pill -->
                <Border DockPanel.Dock="Top" Margin="12,8,12,16"
                        Background="{DynamicResource BgSurfaceVariantBrush}"
                        CornerRadius="6" Padding="8,4">
                    <TextBlock Text="{Binding ActiveModelLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Separator -->
                <Rectangle DockPanel.Dock="Top"
                           Height="1"
                           Fill="{DynamicResource BorderBrush}"
                           Margin="16,0,16,8"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="8,0">
                    <controls:SidebarButton Label="Chat"
                                            IsActive="{Binding IsChatActive}"
                                            Command="{Binding NavigateChatCommand}">
                        <controls:SidebarButton.Icon>
                            <StreamGeometry>M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z</StreamGeometry>
                        </controls:SidebarButton.Icon>
                    </controls:SidebarButton>

                    <controls:SidebarButton Label="Models"
                                            IsActive="{Binding IsModelsActive}"
                                            Command="{Binding NavigateModelsCommand}">
                        <controls:SidebarButton.Icon>
                            <StreamGeometry>M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5</StreamGeometry>
                        </controls:SidebarButton.Icon>
                    </controls:SidebarButton>
                </StackPanel>

                <!-- Bottom nav (Docked to Bottom first so it claims the space) -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="8,0,8,16">
                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="8,8"/>
                    <controls:SidebarButton Label="Settings" IsActive="{Binding IsSettingsActive}" Command="{Binding NavigateSettingsCommand}">
                        <controls:SidebarButton.Icon><StreamGeometry>M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry></controls:SidebarButton.Icon>
                    </controls:SidebarButton>
                    <controls:SidebarButton Label="About" IsActive="{Binding IsAboutActive}" Command="{Binding NavigateAboutCommand}">
                        <controls:SidebarButton.Icon><StreamGeometry>M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry></controls:SidebarButton.Icon>
                    </controls:SidebarButton>
                </StackPanel>

                <!-- Chat history section (Last child fills the remaining middle space) -->
                <Grid RowDefinitions="Auto,*">
                    <!-- Divider + Header -->
                    <StackPanel Grid.Row="0">
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="16,12,16,0"/>
                        <DockPanel Margin="16,8,8,4">
                            <TextBlock Text="Chats" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding NewChatCommand}" ToolTip.Tip="New Chat" Padding="4" HorizontalAlignment="Right">
                                <PathIcon Width="14" Height="14" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                        </DockPanel>
                    </StackPanel>

                    <!-- Session list -->
                    <ListBox Grid.Row="1"
                             x:Name="SessionList"
                             ItemsSource="{Binding ChatSessions}"
                             SelectedItem="{Binding SelectedChatSession}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="8,2"/>
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BgSurfaceVariantBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BgSurfaceVariantBrush}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename" 
                                                      Command="{Binding #SessionList.DataContext.BeginRenameChatSessionCommand}" 
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    
                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding !IsEditing}"/>
                                        <TextBox Text="{Binding Title}" FontSize="12" Padding="2,0" Margin="-4,0,0,0"
                                                 IsVisible="{Binding IsEditing}"
                                                 VerticalContentAlignment="Center"
                                                 MinHeight="20">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" 
                                                            Command="{Binding #SessionList.DataContext.EndRenameChatSessionCommand}" 
                                                            CommandParameter="{Binding}"/>
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM d, HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Command="{Binding #SessionList.DataContext.DeleteChatSessionCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete" Padding="2" Opacity="0.6">
                                        <PathIcon Width="11" Height="11" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ══════════════ CONTENT AREA ══════════════ -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Background="{DynamicResource BgPrimaryBrush}"/>
    </Grid>
</Window>
