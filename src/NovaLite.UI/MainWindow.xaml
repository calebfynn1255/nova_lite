<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaLite.UI.ViewModels"
        xmlns:views="using:NovaLite.UI.Views"
        xmlns:controls="using:NovaLite.UI.Controls"
        x:Class="NovaLite.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NovaLite"
        Width="1240"
        Height="800"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Icon="avares://NovaLite/Assets/icon.png">

    <!-- Design-time DataContext removed to avoid runtime type resolution issues when trimmed -->

    <!-- DataTemplates: map each ViewModel type to its View -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:WelcomePageViewModel}">
            <views:WelcomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatPageViewModel}">
            <views:ChatPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelManagerViewModel}">
            <views:ModelManagerPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutPage/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="272,*">

        <!-- ══════════════ SIDEBAR ══════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSidebarBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource BorderBrush}"
                ClipToBounds="True">

            <Grid>



                <!-- ── Nav content on top ── -->
                <DockPanel>

                    <!-- Simple, Sleek Sidebar Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="14,16,14,12" Spacing="10">
                        <!-- Brand Header & New Chat button -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource NovaGradientBrush}" Padding="5">
                                    <Image Source="avares://NovaLite/Assets/icon.png" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="NovaLite" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="primary" Command="{Binding NewChatCommand}"
                                    Padding="10,6" CornerRadius="8" ToolTip.Tip="Start a new conversation">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <PathIcon Width="12" Height="12" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Foreground="White"/>
                                    <TextBlock Text="New Chat" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Compact Active Model Readout -->
                        <Border Padding="10,8" Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <Border Grid.RowSpan="2" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentGlowBrush}" Margin="0,0,8,0">
                                    <PathIcon Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm4.5 11h-3v3.5h-3V13H7.5v-3h3V6.5h3V10h3z" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="ACTIVE MODEL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveModelLabel}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource AccentGlowBrush}" CornerRadius="6" Padding="5,2" VerticalAlignment="Center">
                                    <TextBlock Text="READY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Nav buttons -->
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="10,0,10,10">
                        <TextBlock Text="EXPLORE" Classes="section-header" Margin="12,0,0,6"/>
                        <controls:SidebarButton Label="Chat"
                                                IsActive="{Binding IsChatActive}"
                                                Command="{Binding NavigateChatCommand}">
                            <controls:SidebarButton.Icon>
                                <StreamGeometry>M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z</StreamGeometry>
                            </controls:SidebarButton.Icon>
                        </controls:SidebarButton>

                        <controls:SidebarButton Label="Models"
                                                IsActive="{Binding IsModelsActive}"
                                                Command="{Binding NavigateModelsCommand}">
                            <controls:SidebarButton.Icon>
                                <StreamGeometry>M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5</StreamGeometry>
                            </controls:SidebarButton.Icon>
                        </controls:SidebarButton>
                    </StackPanel>

                    <!-- Bottom nav -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="3" Margin="10,0,10,16">
                        <Border Background="{DynamicResource BgSurfaceVariantBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8" Margin="2,0,2,10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" VerticalAlignment="Center" BoxShadow="0 0 8 1 #9922C55E"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                    <TextBlock Text="LOCAL &amp; PRIVATE" Classes="caption" FontSize="9" FontWeight="SemiBold"/>
                                    <TextBlock Text="Runs on your PC" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="SYSTEM" Classes="section-header" Margin="10,0,0,4"/>
                        <controls:SidebarButton Label="Settings" IsActive="{Binding IsSettingsActive}" Command="{Binding NavigateSettingsCommand}">
                            <controls:SidebarButton.Icon><StreamGeometry>M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry></controls:SidebarButton.Icon>
                        </controls:SidebarButton>
                        <controls:SidebarButton Label="About" IsActive="{Binding IsAboutActive}" Command="{Binding NavigateAboutCommand}">
                            <controls:SidebarButton.Icon><StreamGeometry>M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry></controls:SidebarButton.Icon>
                        </controls:SidebarButton>
                    </StackPanel>

                    <!-- Chat history section -->
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0">
                            <DockPanel Margin="20,8,12,6">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <TextBlock Text="RECENT CHATS" Classes="section-header"/>
                                    <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="8" Padding="5,1">
                                        <TextBlock Text="{Binding ChatSessions.Count}" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding NewChatCommand}" ToolTip.Tip="New Chat" Padding="5" HorizontalAlignment="Right">
                                    <PathIcon Width="15" Height="15" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </DockPanel>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="SessionList"
                                 ItemsSource="{Binding ChatSessions}"
                                 SelectedItem="{Binding SelectedChatSession}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="10,2"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource BgSurfaceVariantBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource BgSurfaceVariantBrush}"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename"
                                                          Command="{Binding #SessionList.DataContext.BeginRenameChatSessionCommand}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding !IsEditing}"/>
                                            <TextBox Text="{Binding Title}" FontSize="12" Padding="2,0" Margin="-4,0,0,0"
                                                     IsVisible="{Binding IsEditing}"
                                                     VerticalContentAlignment="Center"
                                                     MinHeight="20">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter"
                                                                Command="{Binding #SessionList.DataContext.EndRenameChatSessionCommand}"
                                                                CommandParameter="{Binding}"/>
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:MMM d, HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" Command="{Binding #SessionList.DataContext.DeleteChatSessionCommand}" CommandParameter="{Binding}" ToolTip.Tip="Delete" Padding="2" Opacity="0.6">
                                            <PathIcon Width="11" Height="11" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════ CONTENT AREA ══════════════ -->
        <Grid Grid.Column="1">

            <!-- Background image — always visible as texture -->
            <Image Source="avares://NovaLite/Assets/novalite_side.png"
                   Stretch="UniformToFill"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

            <!-- Theme-aware overlay — BgPrimaryBrush adapts to dark (#030612) or light (#EDE9FE) -->
            <Border Background="{DynamicResource BgPrimaryBrush}" Opacity="0.82"/>

            <!-- Page content -->
            <ContentControl Content="{Binding CurrentPage}"/>

        </Grid>
    </Grid>
</Window>
