<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds (true black for OLED efficiency) ──────────── -->
    <Color x:Key="BgPrimaryColor">#000000</Color>
    <Color x:Key="BgSurfaceColor">#05020D</Color>
    <Color x:Key="BgSurfaceVariantColor">#0A0314</Color>
    <Color x:Key="BgSidebarColor">#020108</Color>
    <Color x:Key="BgInputColor">#06020F</Color>
    <Color x:Key="BgOverlayColor">#99000000</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush"        Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush"        Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSurfaceVariantBrush" Color="{StaticResource BgSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush"        Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgInputBrush"          Color="{StaticResource BgInputColor}"/>

    <!-- ── Borders ────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#120524</Color>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#0A0314"/>

    <!-- ── Accent (brighter violet for pure-black contrast) ──────── -->
    <Color x:Key="AccentColor">#A855F7</Color>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#F472B6"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6A00FF"/>
    <SolidColorBrush x:Key="AccentGlowBrush"    Color="#26A855F7"/>

    <!-- ── Text ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#71717A"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#3F3F46"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#000000"/>

    <!-- ── Chat bubbles ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="UserBubbleBrush"     Color="#6A00FF"/>
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#F5F0FF"/>
    <SolidColorBrush x:Key="AiBubbleBrush"       Color="#06020F"/>
    <SolidColorBrush x:Key="AiBubbleTextBrush"   Color="#E4E4E7"/>

    <!-- ── Sidebar interactive ────────────────────────────────────── -->
    <SolidColorBrush x:Key="SidebarButtonHoverBrush"  Color="#15A855F7"/>
    <SolidColorBrush x:Key="SidebarButtonActiveBrush" Color="#25A855F7"/>

    <!-- ── Scrollbar ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#1C1C22"/>

</ResourceDictionary>
