<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds ───────────────────────────────────────────── -->
    <Color x:Key="BgPrimaryColor">#030612</Color>
    <Color x:Key="BgSurfaceColor">#080F2A</Color>
    <Color x:Key="BgSurfaceVariantColor">#0D173A</Color>
    <Color x:Key="BgSidebarColor">#05091A</Color>
    <Color x:Key="BgInputColor">#040816</Color>
    <Color x:Key="BgOverlayColor">#80000000</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush"        Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush"        Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSurfaceVariantBrush" Color="{StaticResource BgSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush"        Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgInputBrush"          Color="{StaticResource BgInputColor}"/>

    <!-- ── Borders ────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#152250</Color>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#080F2A"/>

    <!-- ── Accent (violet) ───────────────────────────────────────── -->
    <Color x:Key="AccentColor">#6A00FF</Color>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#A855F7"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentGlowBrush"    Color="#336A00FF"/>

    <!-- ── Text ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#52525B"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#FFFFFF"/>

    <!-- ── Chat bubbles ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="UserBubbleBrush"     Color="#6A00FF"/>
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AiBubbleBrush"       Color="#0A1130"/>
    <SolidColorBrush x:Key="AiBubbleTextBrush"   Color="#FAFAFA"/>

    <!-- ── Sidebar interactive ────────────────────────────────────── -->
    <SolidColorBrush x:Key="SidebarButtonHoverBrush"  Color="#1A6A00FF"/>
    <SolidColorBrush x:Key="SidebarButtonActiveBrush" Color="#2D6A00FF"/>

    <!-- ── Scrollbar ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#3F3F46"/>

</ResourceDictionary>
