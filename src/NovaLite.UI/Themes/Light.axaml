<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds ───────────────────────────────────────────── -->
    <Color x:Key="BgPrimaryColor">#FAFAFA</Color>
    <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BgSurfaceVariantColor">#F3F4F6</Color>
    <Color x:Key="BgSidebarColor">#F8FAFC</Color>
    <Color x:Key="BgInputColor">#FFFFFF</Color>
    <Color x:Key="BgOverlayColor">#20000000</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush"        Color="{StaticResource BgPrimaryColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush"        Color="{StaticResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgSurfaceVariantBrush" Color="{StaticResource BgSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush"        Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgInputBrush"          Color="{StaticResource BgInputColor}"/>

    <!-- ── Borders ────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#CBD5E1"/>

    <!-- ── Accent (violet) ───────────────────────────────────────── -->
    <Color x:Key="AccentColor">#6366F1</Color>
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="AccentGlowBrush"    Color="#1F6366F1"/>

    <!-- ── Text ───────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#64748B"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="#FFFFFF"/>

    <!-- ── Chat bubbles ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="UserBubbleBrush"     Color="#6366F1"/>
    <SolidColorBrush x:Key="UserBubbleTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AiBubbleBrush"       Color="#F1F5F9"/>
    <SolidColorBrush x:Key="AiBubbleTextBrush"   Color="#0F172A"/>

    <!-- ── Sidebar interactive ────────────────────────────────────── -->
    <SolidColorBrush x:Key="SidebarButtonHoverBrush"  Color="#106366F1"/>
    <SolidColorBrush x:Key="SidebarButtonActiveBrush" Color="#1F6366F1"/>

    <!-- ── Scrollbar ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#CBD5E1"/>

</ResourceDictionary>
