<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaLite.UI.ViewModels"
             x:Class="NovaLite.UI.Views.SetupWizardPage"
             x:DataType="vm:SetupWizardViewModel"
             Background="{DynamicResource BgPrimaryBrush}">
    
    <Grid Margin="40">
        
        <!-- Step 0: Welcome / Scan -->
        <StackPanel IsVisible="{Binding IsStepScan}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Text="Welcome to Nova Lite" Classes="h1" TextAlignment="Center"/>
            <TextBlock Text="Let&#x2019;s scan your hardware to find the best AI model for you."
                       Classes="secondary" TextAlignment="Center"/>
            <Button Classes="primary" Content="Scan My Hardware" 
                    Command="{Binding StartScanCommand}" 
                    HorizontalAlignment="Center" Width="200" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <!-- Step 1: Recommendations -->
        <StackPanel IsVisible="{Binding IsStepRecommend}" Spacing="16" MaxWidth="600">
            <TextBlock Text="Hardware Profile" Classes="h2"/>
            
            <Border Classes="card" Padding="12">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="CPU:" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="RAM:" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="GPU:" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Hardware.CpuName}" FontSize="12"/>
                        <TextBlock Text="{Binding Hardware.TotalRamMB, StringFormat={}{0} MB}" FontSize="12"/>
                        <TextBlock Text="{Binding Hardware.GpuName}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Recommended Models" Classes="h2" Margin="0,10,0,0"/>
            
            <ListBox ItemsSource="{Binding Recommendations}" 
                     SelectedItem="{Binding SelectedModel}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,8" Padding="12">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Model.Name}" FontWeight="Bold" FontSize="16" Grid.Column="0"/>
                                    <TextBlock Text="{Binding StarRating, StringFormat={}{0} &#x2605;}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Text="{Binding Model.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Reason}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Classes="primary" Content="Download Selected Model" 
                    Command="{Binding StartDownloadCommand}"
                    HorizontalAlignment="Right" Width="220" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <!-- Step 2: Download -->
        <StackPanel IsVisible="{Binding IsStepDownload}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Text="{Binding DownloadStatus}" Classes="h2" TextAlignment="Center"/>
            <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Width="300" Height="12"/>
        </StackPanel>

        <!-- Step 3: Benchmark & Finish -->
        <StackPanel IsVisible="{Binding IsStepFinish}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Text="Setup Complete!" Classes="h1" TextAlignment="Center"/>
            
            <Border Classes="card" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Benchmark Results" Classes="h2" TextAlignment="Center"/>
                    <TextBlock Text="{Binding BenchmarkTokensPerSec, StringFormat={}{0:F1} tokens/sec}" 
                               FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button Classes="primary" Content="Start Chatting" 
                    Command="{Binding FinishCommand}"
                    HorizontalAlignment="Center" Width="200" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
