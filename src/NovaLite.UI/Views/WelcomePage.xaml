<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaLite.UI.ViewModels"
             x:Class="NovaLite.UI.Views.WelcomePage"
             x:DataType="vm:WelcomePageViewModel"
             Background="Transparent">

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="0"
                    MaxWidth="520">
            <Border Width="80" Height="80"
                    CornerRadius="20"
                    Background="{DynamicResource AccentGlowBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,28">
                <Border Width="64" Height="64"
                        CornerRadius="16"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="N"
                               FontSize="36"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Border>

            <TextBlock Text="Welcome to NovaLite"
                       Classes="h1"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="A fast, private AI assistant that runs entirely on your hardware. No cloud, no telemetry — just local intelligence."
                       Classes="secondary"
                       FontSize="15"
                       LineHeight="24"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="NovaLite — Local AI, Your Hardware"
                   Classes="caption"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
    </Grid>
</UserControl>
