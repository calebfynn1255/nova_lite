<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaLite.UI.ViewModels"
        xmlns:setup="using:NovaLite.Setup"
        x:Class="NovaLite.UI.Views.SetupWindow"
        x:DataType="vm:SetupWindowViewModel"
        Title="NovaLite Setup"
        Width="900"
        Height="750"
        MinWidth="800"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Icon="avares://NovaLite/Assets/icon.png">

    <Design.DataContext>
        <vm:SetupWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="40">

        <!-- Step 0: Welcome / Scan -->
        <StackPanel IsVisible="{Binding IsStepScan}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40" MaxWidth="800">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Grid Width="238" Height="202" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse x:Name="SetupLogoGlow"
                             Width="158" Height="158"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" Opacity="0.15"/>
                    <Ellipse x:Name="SetupLogoHalo"
                             Width="198" Height="198"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.22"/>
                    <Image x:Name="SetupHeroLogo"
                           Source="avares://NovaLite/Assets/icon.png"
                           Width="190" Height="190" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="50%,50%"/>
                </Grid>
                <TextBlock Text="Welcome to NovaLite" FontSize="32" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Let's scan your system to find the best AI model for you. NovaLite checks your CPU, memory, graphics hardware, and free storage locally."
                           Classes="secondary" TextAlignment="Center" FontSize="16" Opacity="0.8"/>
            </StackPanel>

            <Button Classes="primary" Content="Scan My Hardware" 
                    Command="{Binding StartScanCommand}" 
                    HorizontalAlignment="Center" Width="200" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <!-- Step 1: Recommendations -->
        <Grid IsVisible="{Binding IsStepRecommend}" MaxWidth="750" RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Your Hardware" Classes="h2"/>
                    
                    <Border Classes="card" Padding="16">
                        <StackPanel Spacing="8">
                            <!-- CPU -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="CPU:" FontWeight="Bold" FontSize="12" Width="50"/>
                                <TextBlock Text="{Binding Hardware.CpuName}" FontSize="12"/>
                                <TextBlock Text="{Binding Hardware.CpuCores, StringFormat=({0} cores)}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <!-- RAM -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="RAM:" FontWeight="Bold" FontSize="12" Width="50"/>
                                <TextBlock Text="{Binding Hardware.TotalRamMB, StringFormat={}{0} MB}" FontSize="12"/>
                            </StackPanel>
                            <!-- GPUs -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="GPUs:" FontWeight="Bold" FontSize="12"/>
                                <ItemsControl ItemsSource="{Binding Hardware.Gpus}" Margin="58,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="setup:GpuInfo">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <!-- Drives -->
                            <StackPanel Spacing="2">
                                <TextBlock Text="Drives:" FontWeight="Bold" FontSize="12"/>
                                <ItemsControl ItemsSource="{Binding Hardware.Drives}" Margin="58,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="setup:DiskDriveInfo">
                                            <TextBlock Text="{Binding DisplayText}" FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recommended Models" Classes="h2" Margin="0,10,0,0"/>
                    <TextBlock Text="Hold Ctrl and click to select multiple models" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    
                    <ListBox x:Name="ModelsListBox"
                             ItemsSource="{Binding Recommendations}" 
                             SelectionMode="Multiple"
                             SelectionChanged="OnModelSelectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecommendedModelViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="12">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="16" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Model.DownloadSizeDisplay}" 
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StarRating, StringFormat={}{0} &#x2605;}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Grid.Column="2"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Model.Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>

                                        <!-- Resume indicator: shown only when this model has a partial download -->
                                        <Border IsVisible="{Binding IsPendingResume}"
                                                Background="#1A8B5CF6" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                            <StackPanel Spacing="8">
                                                <!-- Header row -->
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Width="13" Height="13"
                                                              Data="M8 5v14l11-7z"
                                                              Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="Download in progress — you can resume this model"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Progress -->
                                                <ProgressBar Value="{Binding ResumeProgress}" Maximum="100" Height="6" CornerRadius="3"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding ResumeProgress, StringFormat='{}{0:F1}% already downloaded'}"
                                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <!-- Resume button -->
                                                    <Button Grid.Column="1" Classes="primary"
                                                            Command="{Binding $parent[ListBox].DataContext.ResumeFromCardCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="12,4" FontSize="12">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <PathIcon Width="11" Height="11"
                                                                      Data="M8 5v14l11-7z" Foreground="White"/>
                                                            <TextBlock Text="Resume" Foreground="White"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons docked at bottom -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Classes="secondary" Content="&#x2190; Back" 
                        Command="{Binding GoBackCommand}"/>
                <Button Classes="primary" Content="Next &#x2192;" 
                        Command="{Binding GoToPathSelectionCommand}" 
                        IsEnabled="{Binding HasSelection}"
                        Width="150" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Step 2: Path & Shortcut -->
        <StackPanel IsVisible="{Binding IsStepPath}" VerticalAlignment="Center" Spacing="20" MaxWidth="600">
            <TextBlock Text="Installation Settings" Classes="h1" TextAlignment="Center"/>
            
            <TextBlock Text="Where would you like to store your GGUF models?" FontSize="13"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding InstallPath}" IsReadOnly="True" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePathCommand}"/>
            </Grid>
            
            <TextBlock Text="{Binding RequiredSpaceStr}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                <Button Classes="secondary" Content="&#x2190; Back" 
                        Command="{Binding GoBackCommand}"/>
                <Button Classes="primary" Content="Download &amp; Install" 
                        Command="{Binding StartDownloadCommand}" Width="220" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Step 3: Download -->
        <StackPanel IsVisible="{Binding IsStepDownload}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Width="480">

            <TextBlock Text="Downloading Model" Classes="h2" TextAlignment="Center"/>

            <!-- Status -->
            <TextBlock Text="{Binding DownloadStatus}"
                       Classes="secondary" TextAlignment="Center"
                       TextWrapping="Wrap"/>

            <!-- Progress bar + percentage -->
            <StackPanel Spacing="6">
                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="14" CornerRadius="7"
                             IsIndeterminate="{Binding IsBenchmarking}"/>
                <TextBlock Text="{Binding DownloadProgress, StringFormat='{}{0:F1}%'}"
                           IsVisible="{Binding !IsBenchmarking}"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="12" Width="400">

                <!-- Continue & Load Model (visible when download is ready) -->
                <Button Classes="primary"
                        Command="{Binding ProceedToChatCommand}"
                        IsVisible="{Binding IsDownloadReady}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,12"
                        MinHeight="44">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16"
                                  Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                  Foreground="White"/>
                        <TextBlock Text="Continue &amp; Load Model" Foreground="White"
                                   FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <!-- Pause (visible while downloading and not paused and not ready) -->
                    <Button Classes="secondary"
                            Command="{Binding PauseDownloadCommand}"
                            IsVisible="{Binding IsDownloading}"
                            Width="120" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="13" Height="13"
                                      Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                            <TextBlock Text="Pause"/>
                        </StackPanel>
                    </Button>

                    <!-- Resume (visible while paused) -->
                    <Button Classes="primary"
                            Command="{Binding ResumeDownloadCommand}"
                            IsVisible="{Binding IsPaused}"
                            Width="120" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="13" Height="13"
                                      Data="M8 5v14l11-7z" Foreground="White"/>
                            <TextBlock Text="Resume" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel (visible while downloading or paused) -->
                    <Button Classes="ghost"
                            Command="{Binding StopDownloadCommand}"
                            IsVisible="{Binding !IsDownloadReady}"
                            Width="120" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="13" Height="13"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
